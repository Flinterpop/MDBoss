# Python
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local virtualenv created by run.sh on Linux/macOS
.venv/

# PyInstaller / build outputs
build/
dist/
# C++ ASan-instrumented build tree used to hunt the save-path use-after-free
build-asan/
# AppImage build artifacts (belong in dist/; ignore stray ones too)
*.AppImage
*.AppImage.zsync
# Compiled installer -- published as a GitHub Release asset, not committed
installer/

# Local editor / tool settings
.claude/

# Local reference screenshots (not part of the app)
MD_Note.jpg

# Intermediate icon renders (source is mdboss.svg; runtime uses mdboss.ico)
mdboss_*.png

# C++ port: failure dumps written beside the golden corpus by the parity
# tests.  The goldens themselves ARE tracked -- they are the expectation.
MDBossCpp/tests/golden/*.actual.*

# Third-party vendored assets are tracked (assets/); nothing here is ignored.
