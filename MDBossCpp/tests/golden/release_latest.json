pi.github.com/users/Flinterpop/followers","following_url":"https://api.github.com/users/Flinterpop/following{/other_user}","gists_url":"https://api.github.com/users/Flinterpop/gists{/gist_id}","starred_url":"https://api.github.com/users/Flinterpop/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Flinterpop/subscriptions","organizations_url":"https://api.github.com/users/Flinterpop/orgs","repos_url":"https://api.github.com/users/Flinterpop/repos","events_url":"https://api.github.com/users/Flinterpop/events{/privacy}","received_events_url":"https://api.github.com/users/Flinterpop/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":523060,"digest":"sha256:47484756cbb6259193420015030d018cbc236c4cc687b358c9a70a0d6fa162c2","download_count":0,"created_at":"2026-07-28T22:26:54Z","updated_at":"2026-07-28T22:26:54Z","browser_download_url":"https://github.com/Flinterpop/MDBoss/releases/download/v1.1.1/MDBoss-x86_64.AppImage.zsync"}],"tarball_url":"https://api.github.com/repos/Flinterpop/MDBoss/tarball/v1.1.1","zipball_url":"https://api.github.com/repos/Flinterpop/MDBoss/zipball/v1.1.1","body":"### Fixed: Delete did not use the Recycle Bin\n\n**In v1.1.0 and earlier, deleting a file from the tree destroyed it\npermanently instead of sending it to the Recycle Bin, and said nothing.**\n\n`Send2Trash` was declared as a dependency but was not present in the build\nenvironment, so it was never packaged, and the app silently fell through to a\npermanent delete. If you deleted something from MD Boss and could not find it\nin the Recycle Bin, that is why — and it is not recoverable from within the\napp.\n\nIt is now packaged, and a test fails the build if it ever goes missing again.\nShould it somehow be absent, the app no longer deletes quietly: it names the\nfile, says the delete would be permanent, and defaults to *No*.\n\nThis affected the **Python** build only. The C++ build was never affected — it\nuses the Windows shell's own delete-to-Recycle-Bin call and depends on nothing\nfor it.\n\n### MD Boss (C++)\n\n- **Updates now install themselves.** `Help → Check for updates` downloads\n  this build's installer, waits for the app to close, installs, and reopens.\n  Previously it opened the releases page. It still only checks when you ask —\n  there is no check on launch.\n\n### Notes\n\nAlso in this release: the C++ project version had drifted out of step with\nthe rest of the build and is now covered by the same lockstep test as\neverything else.\n"}