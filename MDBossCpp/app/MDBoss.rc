// Version resource and application icon.
//
// The repo versions its apps in lockstep: app.py's APP_VERSION,
// installer.iss's AppVersion, app/Version.h's kAppVersion and the two forms
// below must all agree, and a test in tests/test_version.cpp fails the build
// if they drift.
//
// Both forms matter.  Explorer's Details tab reads the STRING "FileVersion",
// while installers and update checks compare the NUMERIC FILEVERSION tuple;
// updating one and not the other is the classic way to ship an installer that
// refuses to upgrade.

#include <windows.h>

// The application icon must be first by ordinal, because Windows uses the
// LOWEST-numbered icon resource for the executable itself.
1 ICON "..\\..\\mdboss.ico"

// The studio icon shown in the About box.  Embedded rather than installed
// beside the exe so there is no extra file for the installer to place, and
// none to go missing.
2 ICON "..\\..\\bungee.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,4,3,0
PRODUCTVERSION 1,4,3,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"          // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Flinterpop"
            VALUE "FileDescription",  "MD Boss - Markdown manager and viewer"
            VALUE "FileVersion",      "1.4.3"
            VALUE "InternalName",     "MDBoss"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "MDBoss.exe"
            VALUE "ProductName",      "MD Boss"
            VALUE "ProductVersion",   "1.4.3"
            VALUE "Comments",         "C++ / wxWidgets port"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
